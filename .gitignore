# History files
.Rhistory
.Rapp.history

# Session Data files
.RData
.RDataTmp

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf
vignettes/*_files/

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# pkgdown site
docs/

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/
.DS_Store

# Claude files (CLAUDE.md sí se versiona: documenta la arquitectura del proyecto)
.claude/

# Copias de conflicto de iCloud Drive
*[ ][0-9].R
*[ ][0-9].md

# Salidas de BiocCheck y R CMD check
NADIA.BiocCheck/
*.Rcheck/

# The full experiments and their analysis outputs. Unpublished data, kept on the
# maintainer's machine only: they were purged from the history in phase 6c and
# must not come back. .Rbuildignore keeps them out of the tarball as well, and
# it still has to, because they remain on disk.
data-raw/
results/

# The numbered driver scripts. They read data-raw/ and results/, several point at
# files that no longer exist, and Bioconductor asks that the default branch hold
# only package code. They are preserved on the 'dev' branch.
[0-9]*_*.R
Rplots.pdf

# Internal working notes: the agent brief, the submission checklist and the code
# review reports. They are kept on the maintainer's machine, never published.
# .Rbuildignore already keeps them out of the tarball, and it still has to,
# because they remain on disk.
CLAUDE.md
SUBMISSION.md
CODE_REVIEW_*.md
