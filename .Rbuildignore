^data-raw$
^results$
^\.claude$
^\.Rproj\.user$
^.*\.Rproj$
^\.Rhistory$
^CLAUDE\.md$
^CODE_REVIEW_.*\.md$
^SUBMISSION\.md$
^install_dependencies\.R$
^[0-9].*\.R$
^\.github$
^LICENSE\.md$
^NADIA\.Rcheck$
\.Rcheck$
\.BiocCheck$
\.tar\.gz$
# Copias de conflicto que crea iCloud Drive durante el build: "fichero 2.R",
# "NADIA_0.99.0 2.tar.gz", ... Cualquier nombre con un espacio antes de la
# extension no es portable y R CMD check lo marca.
[ ][0-9]+\.

# Vinetas renderizadas en local para revisarlas (git ya las ignora). Sin esto
# viajan en el tarball ademas de las que R CMD build deja en inst/doc.
^vignettes/.*\.html$
^vignettes/.*\.pdf$
^vignettes/.*_files$
